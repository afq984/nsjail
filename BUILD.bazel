load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_bison//bison:bison.bzl", "bison")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_flex//flex:flex.bzl", "flex")

# --------------------------------------------------------------------------
# Protobuf
# --------------------------------------------------------------------------

proto_library(
    name = "config_proto",
    srcs = ["config.proto"],
)

cc_proto_library(
    name = "config_cc_proto",
    deps = [":config_proto"],
)

# --------------------------------------------------------------------------
# Kafel — seccomp-bpf policy compiler (git submodule)
#
# The kafel source files contain hardcoded output path directives
# (%option outfile/header-file in lexer.l, %output/%defines in parser.y)
# that override the command-line flags rules_flex/rules_bison pass.
# We strip those directives before feeding the files to the stock rules.
# --------------------------------------------------------------------------

genrule(
    name = "lexer_patched",
    srcs = ["kafel/src/lexer.l"],
    outs = ["lexer_patched.l"],
    cmd = "sed '/^%option outfile=.*header-file=/d' $< > $@",
)

flex(
    name = "lexer",
    src = ":lexer_patched",
)

genrule(
    name = "parser_patched",
    srcs = ["kafel/src/parser.y"],
    outs = ["parser_patched.y"],
    cmd = "sed -e '/^%output /d' -e '/^%defines /d' $< > $@",
)

bison(
    name = "parser",
    src = ":parser_patched",
)

cc_library(
    name = "kafel",
    srcs = [
        "kafel/src/codegen.c",
        "kafel/src/context.c",
        "kafel/src/expression.c",
        "kafel/src/includes.c",
        "kafel/src/kafel.c",
        "kafel/src/parser_types.c",
        "kafel/src/policy.c",
        "kafel/src/range_rules.c",
        "kafel/src/syscall.c",
        "kafel/src/syscalls/aarch64_syscalls.c",
        "kafel/src/syscalls/amd64_syscalls.c",
        "kafel/src/syscalls/arm_syscalls.c",
        "kafel/src/syscalls/i386_syscalls.c",
        "kafel/src/syscalls/m68k_syscalls.c",
        "kafel/src/syscalls/mips64_syscalls.c",
        "kafel/src/syscalls/mipso32_syscalls.c",
        "kafel/src/syscalls/riscv64_syscalls.c",
        ":lexer",
        ":parser",
    ] + glob(["kafel/src/**/*.h"]),
    hdrs = ["kafel/include/kafel.h"],
    copts = [
        "-std=gnu11",
        "-fvisibility=hidden",
        "-Wno-unused",
        "-Wno-unused-parameter",
        "-Wno-error",
    ],
    includes = [
        "kafel/include",
        "kafel/src",
    ],
)

# --------------------------------------------------------------------------
# nsjail
# --------------------------------------------------------------------------

_NSJAIL_COPTS = [
    "-Wall",
    "-Wextra",
    "-Werror",
    "-Wformat",
    "-Wformat-security",
    "-Wno-format-nonliteral",
    "-Wno-unused",
    "-Wno-unused-parameter",
]

cc_library(
    name = "nsjail_lib",
    srcs = [
        "caps.cc",
        "cgroup.cc",
        "cgroup2.cc",
        "cmdline.cc",
        "config.cc",
        "contain.cc",
        "cpu.cc",
        "logs.cc",
        "mnt.cc",
        "mnt_legacy.cc",
        "mnt_newapi.cc",
        "net.cc",
        "pid.cc",
        "sandbox.cc",
        "subproc.cc",
        "user.cc",
        "util.cc",
        "uts.cc",
    ],
    hdrs = [
        "caps.h",
        "cgroup.h",
        "cgroup2.h",
        "cmdline.h",
        "config.h",
        "contain.h",
        "cpu.h",
        "logs.h",
        "macros.h",
        "mnt.h",
        "mnt_legacy.h",
        "mnt_newapi.h",
        "net.h",
        "nsjail.h",
        "pid.h",
        "sandbox.h",
        "subproc.h",
        "user.h",
        "util.h",
        "uts.h",
    ],
    copts = _NSJAIL_COPTS,
    linkopts = [
        "-lpthread",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":config_cc_proto",
        ":kafel",
        "@protobuf//:protobuf",
    ],
)

cc_binary(
    name = "nsjail",
    srcs = ["nsjail.cc"],
    copts = _NSJAIL_COPTS,
    deps = [":nsjail_lib"],
)
